    // 1. فحص هل الباقة غير محدودة (الحد يساوي 0)
    $isUnlimited = ($limit == 0);

    // 2. فحص هل وصل الاستهلاك للحد الأقصى (ولا نطبق هذا الشرط على المفتوح)
    $isFull = (!$isUnlimited && $current >= $limit);
    
    // 3. تحديد اللون بناءً على الحالة
    if ($isFull) {
        $displayColor = 'bg-rose-500'; // أحمر
