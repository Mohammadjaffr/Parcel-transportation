        $rawCode = ltrim($country['dial_code'], '+');
        if (preg_match('/^(\+|00)?' . $rawCode . '/', $value)) {
            $detectedCode = $code;
            $clean = preg_replace('/^(\+|00)?' . $rawCode . '/', '', $value);
            break;
        }
    }
@endphp

