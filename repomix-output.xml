       removeItem(index) {
    if (this.items.length > 1) {
        this.items.splice(index, 1);
        if (this.activeItem === index) {
            this.activeItem = Math.max(0, index - 1);
        } else if (this.activeItem > index) {
            this.activeItem--;
        }
    } else {
        alert('يجب أن تحتوي الإرسالية على طرد واحد على الأقل.');
    }
},
        
        initDriverPhone() {
            let p = '{{ old('driver_phone', $package->driver->phone ?? '') }}';
            if(p) {
                const codes = this.countries.map(c => c.dial_code.replace('+', '')).sort((a, b) => b.length - a.length);
                for (const code of codes) {
                    let regex = new RegExp('^(\\+|00)?' + code);
                    if (regex.test(p)) {
                        this.selectedCountry = this.countries.find(c => c.dial_code.replace('+', '') === code);
                        p = p.replace(regex, '');
                        break;
                    }
                }
                this.localPhoneNumber = p;
            }
        }
