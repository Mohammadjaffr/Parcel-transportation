@section('script')
    <script>
        function userFilter() {
            return {
                search: "",
                statusFilter: "all",

                users: @json($users->items()),
                countries: @json(array_values(config('countries') ?? [])),

                isModalOpen: false,
                editModalOpen: false,
                isSubmitting: false,
                errors: {},

                createUser: {
                    name: '',
                    phone: '',
                    whatsapp_number: '',
                    type: '',
                    branch_id: '',
                    password: '',
                    is_banned: 0
                },

                editUser: {
                    id: null,
                    name: '',
                    phone: '',
                    whatsapp_number: '',
                    type: '',
                    branch_id: '',
                    is_banned: 0,
                    url: ''
                },

                get filteredUsers() {
                    let result = this.users;

                    if (this.statusFilter !== 'all') {
                        const targetBanned = this.statusFilter === 'banned' ? 1 : 0;
                        result = result.filter(user => Number(user.is_banned) === targetBanned);
                    }

                    if (this.search.trim() !== "") {
                        const searchTerm = this.search.toLowerCase().trim();

                        result = result.filter(user => {
                            const name = String(user.name || '').toLowerCase();
                            const phone = String(user.phone || '');
                            const whatsapp = String(user.whatsapp_number || '');

                            return name.includes(searchTerm) ||
                                phone.includes(searchTerm) ||
                                whatsapp.includes(searchTerm);
                        });
                    }

                    return result;
                },

                getInitial(name) {
                    return name ? String(name).charAt(0) : '?';
                },

                detectCountry(phone) {
                    if (!phone) {
                        return this.getDefaultCountry();
                    }

                    let value = String(phone).replace(/[^\d+]/g, '');

                    for (const country of this.countries) {
                        const dialCode = String(country.dial_code || '').replace('+', '');

                        if (!dialCode) {
                            continue;
                        }

                        const regex = new RegExp('^(\\+|00)?' + dialCode);

                        if (regex.test(value)) {
                            return country;
                        }
                    }

                    return this.getDefaultCountry();
                },

                getDefaultCountry() {
                    return this.countries.find(country => country.code === 'YE') || this.countries[0] || null;
                },

                getFlagSvg(phone) {
                    const country = this.detectCountry(phone);

                    if (country && country.svg) {
                        return country.svg;
                    }

                    const code = country && country.code ? country.code : 'YE';

                    return `<span class="inline-flex items-center justify-center w-full h-full text-[9px] font-black bg-gray-100 text-gray-500">${code}</span>`;
                },

                cleanPhone(phone) {
                    if (!phone) {
                        return '';
                    }

                    let value = String(phone).replace(/[^\d+]/g, '');
                    const country = this.detectCountry(value);

                    if (country && country.dial_code) {
                        const dialCode = String(country.dial_code).replace('+', '');
                        const regex = new RegExp('^(\\+|00)?' + dialCode);
                        value = value.replace(regex, '');
                    }

                    value = value.replace(/^\+/, '');

                    return value;
                },

                openCreateModal() {
                    this.errors = {};

                    this.createUser = {
                        name: '',
                        phone: '',
                        whatsapp_number: '',
                        type: '',
                        branch_id: '',
                        password: '',
                        is_banned: 0
                    };

                    this.isSubmitting = false;
                    this.isModalOpen = true;
                },

                closeModals() {
                    this.isModalOpen = false;
                    this.editModalOpen = false;
                    this.errors = {};
                    this.isSubmitting = false;
                },

                openEditModal(user) {
                    this.errors = {};
                    this.isSubmitting = false;

                    this.editUser = {
                        id: user.id,
                        name: user.name || '',
                        phone: user.phone || '',
                        whatsapp_number: user.whatsapp_number || '',
                        type: user.type || '',
                        branch_id: user.branch_id || '',
                        is_banned: user.is_banned ?? 0,
                        url: '{{ url('users') }}/' + user.id
                    };

                    this.editModalOpen = true;
                }
            }
        }
    </script>
