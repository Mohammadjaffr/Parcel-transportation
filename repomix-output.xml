    public function outgoingEdit(Request $request, $id)
    {
        $shipment = Shipment::with([
            'senderCustomer',
            'receiverCustomer',
            'receiverBranch'
        ])->findOrFail($id);

        if (auth()->user()->type !== 'admin' && $shipment->status !== 'pending') {
