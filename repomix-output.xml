    //     // إحصائيات أعلى الصفحة
    //     $todayShipments = Shipment::whereDate('created_at', today())->count();
    //     $inTransit = Shipment::where('status', 'in_transit')->count();
    //     $delivered = Shipment::where('status', 'delivered')->count();

    //     // الإيرادات COD المحصّلة
