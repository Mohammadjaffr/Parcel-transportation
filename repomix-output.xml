        getArabicDayName(dateString) {
            if (!dateString) return '';
            const days = ['الاحد', 'الاثنين', 'الثلاثاء', 'الاربعاء', 'الخميس', 'الجمعة', 'السبت'];
            const dateObj = new Date(dateString);
            return isNaN(dateObj.getTime()) ? '' : days[dateObj.getDay()];
        }
